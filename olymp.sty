\cs_new_protected:Npn \__olymp_example_read_file:nN #1#2
  {
    \seq_clear:N #2
    \ior_open:Nn \l__olymp_example_ior {#1}
    \ior_str_map_inline:Nn \l__olymp_example_ior
      { \seq_put_right:Nn #2 {##1} }
    \ior_close:N \l__olymp_example_ior
  }

\cs_new:Npn \__olymp_example_space:
  { \hspace*{\fontdimen2\font} }

\cs_new_protected:Npn \__olymp_example_typeset_line:n #1
  {
    \tl_set:Nn \l_tmpa_tl {#1}
    \tl_replace_all:Nnn \l_tmpa_tl { ~ } { \__olymp_example_space: }
    \tl_use:N \l_tmpa_tl
  }

% Split a logical line into measured display lines before building the table.
% Each display line is a separate row, so even one very long source line can
% cross a page. The arrow is presentation only and never read from the file.
\cs_new_protected:Npn \__olymp_example_save_chunk:
  {
    \seq_put_right:Nx \l__olymp_example_wrapped_seq
      {
        \exp_not:N \hbox
          {
            \bool_if:NT \l__olymp_example_continued_bool
              { \exp_not:N \ExampleContinuationMarker }
            \exp_not:N \__olymp_example_typeset_line:n
              { \exp_not:V \l__olymp_example_chunk_tl }
          }
      }
  }

\cs_new_protected:Npn \__olymp_example_append_char:n #1
  {
    \tl_set_eq:NN \l__olymp_example_candidate_tl \l__olymp_example_chunk_tl
    \tl_put_right:Nn \l__olymp_example_candidate_tl {#1}
    % Measure the complete candidate: xeCJK inserts context-dependent spacing
    % between scripts, so adding the widths of isolated glyphs is insufficient.
    \hbox_set:Nn \l__olymp_example_chunk_box
      {
