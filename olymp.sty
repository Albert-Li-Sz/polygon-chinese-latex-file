            \bool_set_true:N \l__olymp_example_continued_bool
          }
        \hbox_set:Nn \l__olymp_example_chunk_box
          {
            \bool_if:NT \l__olymp_example_continued_bool
              { \ExampleContinuationMarker }
            \__olymp_example_typeset_line:n {#1}
          }
